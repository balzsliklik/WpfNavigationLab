<Page x:Class="WpfNavigationLab.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfNavigationLab"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingPage">

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Beállítások"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#1E293B"/>

            <TextBlock Text="Rendszerbeállítások és testreszabás"
                   FontSize="16"
                   Foreground="#64748B"
                   Margin="0,10,0,25"/>

            <CheckBox Content="Értesítések engedélyezése"
                  FontSize="16"
                  Margin="0,0,0,20"/>

            <Button Content="Vissza"
                Height="40"
                Click="Back_Click"/>
        </StackPanel>
    </Grid>

</Page>
