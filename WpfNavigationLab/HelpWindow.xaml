<Window x:Class="WpfNavigationLab.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfNavigationLab"
        mc:Ignorable="d"
        Title="HelpWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Súgó"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

            <TextBlock Text="Ez a modális súgó ablak ShowDialog() segítségével jelent meg."
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"
                   Foreground="#475569"/>

            <Button Content="Bezárás"
                Height="40"
                Click="Close_Click"/>
        </StackPanel>
    </Grid>

</Window>
